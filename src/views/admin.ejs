<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main class="container hidden-until-auth">
    <h4 class="page-title">Panel de administración</h4>
    <p class="grey-text">Usuarios registrados en el sistema</p>

    <div class="row">
        <div class="col s12 m4">
            <div class="card stat-card"><div class="card-content">
                <i class="material-icons teal-text">groups</i>
                <div><h5 id="statTotal">0</h5><span class="grey-text">Usuarios totales</span></div>
            </div></div>
        </div>
        <div class="col s12 m4">
            <div class="card stat-card"><div class="card-content">
                <i class="material-icons amber-text">admin_panel_settings</i>
                <div><h5 id="statAdmins">0</h5><span class="grey-text">Administradores</span></div>
            </div></div>
        </div>
        <div class="col s12 m4">
            <div class="card stat-card"><div class="card-content">
                <i class="material-icons blue-text">person</i>
                <div><h5 id="statUsers">0</h5><span class="grey-text">Usuarios estándar</span></div>
            </div></div>
        </div>
    </div>

    <div class="card">
        <div class="card-content">
            <div class="input-field">
                <i class="material-icons prefix">search</i>
                <input id="search" type="text">
                <label for="search">Buscar por nombre o email</label>
            </div>
            <div class="table-wrap">
                <table class="highlight">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Edad</th>
                            <th>Rol</th>
                            <th>Fecha de registro</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                        <tr><td colspan="8" class="center-align grey-text">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

<div id="userModal" class="modal">
    <div class="modal-content" id="modalBody"></div>
    <div class="modal-footer">
        <a href="#!" class="modal-close btn-flat">Cerrar</a>
    </div>
</div>

<%- include('partials/footer') %>
<script>
    const session = requireAuth(['admin']);
    let users = [];
    M.Modal.init(document.querySelectorAll('.modal'));
    if (session) loadUsers();

    async function loadUsers() {
        try {
            users = await apiFetch('/api/users');
            const admins = users.filter(u => u.roles.includes('admin')).length;
            document.getElementById('statTotal').textContent = users.length;
            document.getElementById('statAdmins').textContent = admins;
            document.getElementById('statUsers').textContent = users.length - admins;
            renderTable(users);
        } catch (err) {
            showToast(err.message);
        }
    }

    function renderTable(list) {
        const tbody = document.getElementById('tbody');
        if (!list.length) {
            tbody.innerHTML = '<tr><td colspan="8" class="center-align grey-text">No se encontraron usuarios</td></tr>';
            return;
        }
        tbody.innerHTML = list.map((u, i) => `
            <tr>
                <td>${i + 1}</td>
                <td>${esc(u.name)} ${esc(u.lastName)}</td>
                <td>${esc(u.email)}</td>
                <td>${esc(u.phoneNumber)}</td>
                <td>${u.age ?? '-'}</td>
                <td>${rolesHtml(u.roles)}</td>
                <td>${formatDateTime(u.createdAt)}</td>
                <td>
                    <button class="btn-small teal darken-2" data-id="${esc(u.id)}">
                        <i class="material-icons left">visibility</i>Ver
                    </button>
                </td>
            </tr>
        `).join('');
    }

    document.getElementById('tbody').addEventListener('click', (e) => {
        const btn = e.target.closest('button[data-id]');
        if (!btn) return;
        const user = users.find(u => u.id === btn.dataset.id);
        if (user) openUser(user);
    });

    function openUser(u) {
        const rows = [
            ['email', 'Email', u.email],
            ['phone', 'Teléfono', u.phoneNumber],
            ['cake', 'Fecha de nacimiento', formatDate(u.birthdate)],
            ['hourglass_empty', 'Edad', `${u.age} años`],
            ['home', 'Dirección', u.address || '-'],
            ['link', 'URL de perfil', u.url_profile || '-'],
            ['event', 'Registrado', formatDateTime(u.createdAt)],
            ['update', 'Última actualización', formatDateTime(u.updatedAt)]
        ];
        document.getElementById('modalBody').innerHTML = `
            <div class="center-align">
                ${avatarHtml(u)}
                <h5>${esc(u.name)} ${esc(u.lastName)}</h5>
                ${rolesHtml(u.roles)}
            </div>
            <ul class="info-list">
                ${rows.map(([icon, label, value]) =>
                    `<li><i class="material-icons teal-text">${icon}</i><b>${label}:</b> ${esc(value)}</li>`
                ).join('')}
            </ul>
        `;
        M.Modal.getInstance(document.getElementById('userModal')).open();
    }

    document.getElementById('search').addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase().trim();
        renderTable(users.filter(u =>
            `${u.name} ${u.lastName} ${u.email}`.toLowerCase().includes(q)
        ));
    });
</script>
</body>
</html>